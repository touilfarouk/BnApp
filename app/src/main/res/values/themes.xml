<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="Theme.BnApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/primary_light</item>
        
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Customize your theme here. -->
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        
        <!-- Button styles -->
        <item name="materialButtonStyle">@style/Widget.BnApp.Button</item>
        <item name="cardViewStyle">@style/Widget.BnApp.CardView</item>
        
        <!-- Text appearance -->
        <item name="textAppearanceHeadline6">@style/TextAppearance.BnApp.Headline</item>
        <item name="textAppearanceBody1">@style/TextAppearance.BnApp.Body</item>
    </style>

    <!-- Button Style -->
    <style name="Widget.BnApp.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:padding">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- CardView Style -->
    <style name="Widget.BnApp.CardView" parent="@style/Widget.MaterialComponents.CardView">
        <item name="cardElevation">2dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardBackgroundColor">@color/white</item>
    </style>

    <!-- Text Styles -->
    <style name="TextAppearance.BnApp.Headline" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.BnApp.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Theme overlay for dark theme -->
    <style name="ThemeOverlay.BnApp.Dark" parent="">
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>